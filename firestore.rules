rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone holding the website link can view the roster.
    // Replace the placeholder with the UID of the sole editor.
    match /rosters/{year} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "PASTE_YOUR_FIREBASE_AUTH_UID_HERE";
    }
  }
}
